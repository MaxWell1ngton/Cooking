# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API). .env.local is gitignored.
#
# These must be NEXT_PUBLIC_-prefixed because this app is a static export
# with no server: Next.js inlines NEXT_PUBLIC_ variables into the browser
# bundle at build time. The anon key is meant to be public — it's safe as
# long as Row Level Security policies are in place on every table (see
# supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
